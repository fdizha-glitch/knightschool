# OpenAI API key — used for Whisper STT and optional GPT-4 coaching
# Get yours at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# (Optional) Use GPT-4 for richer coaching explanations
# Set to "true" to enable. Falls back to rule-based coaching if unset.
ENABLE_LLM_COACH=false

# (Optional) Path to a stockfish binary if not on PATH
# e.g. /usr/local/bin/stockfish  or  /opt/homebrew/bin/stockfish
STOCKFISH_PATH=

# Node environment
NODE_ENV=development
